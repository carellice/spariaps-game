; Spariaps — versione nativa per Windows (Godot 4)

config_version=5

[application]

config/name="Spariaps"
config/description="Sparatutto arena in prima persona: ondate, zombie e boss."
config/version="2.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0.043, 0.059, 0.086, 1)
boot_splash/show_image=false

[autoload]

G="*res://scripts/g.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.043, 0.059, 0.086, 1)
textures/default_filters/anisotropic_filtering_level=3
